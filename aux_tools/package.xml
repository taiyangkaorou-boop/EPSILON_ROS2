<?xml version="1.0"?>
<package format="3">
  <!-- 人机交互与轻量可视化辅助包，不参与规划决策和轨迹求解。 -->
  <name>aux_tools</name>
  <version>1.0.0</version>
  <description>aux_tools</description>
  <maintainer email="test@gmail.com">test</maintainer>
  <license>BSD</license>

  <!-- ament 负责包注册；运行脚本依赖 ROS2 Python、传感器和车辆自定义消息。 -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclpy</depend>
  <depend>rosconsole</depend>
  <depend>sensor_msgs</depend>
  <depend>image_transport</depend>
  <depend>dynamic_reconfigure</depend>
  <depend>vehicle_msgs</depend>

  <!-- 本包采用 ament_cmake 构建类型。 -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
