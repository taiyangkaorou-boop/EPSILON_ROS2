<?xml version="1.0"?>
<package format="3">
  <name>eudm_planner</name>
  <version>0.0.0</version>
  <description>eudm_planner</description>
  <maintainer email="wdingae@todo.com">HKUST_UAV_GROUP</maintainer>
  <license>TODO</license>

  <!-- ament 构建工具及当前声明的编译/运行依赖。 -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>common</depend>
  <depend>vehicle_model</depend>
  <depend>semantic_map_manager</depend>
  <depend>forward_simulator</depend>
  <depend>route_planner</depend>
  <depend>vehicle_msgs</depend>
  <depend>protobuf</depend>
  <depend>glog</depend>

  <!-- 当前包不生成 ROS interface，此依赖需要在 M1 复核。 -->
  <build_depend>rosidl_default_runtime</build_depend>

  <!-- 声明标准 ament_cmake 构建类型。 -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
