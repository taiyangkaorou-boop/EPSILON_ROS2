<?xml version="1.0"?>
<package format="3">
  <name>ssc_planner</name>
  <version>0.0.0</version>
  <description>ssc_planner</description>
  <maintainer email="wdingae@todo.com">HKUST_UAV_GROUP</maintainer>
  <license>TODO</license>

  <!-- ament 构建工具及 SSC 当前显式声明的编译/运行依赖。 -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>rclpy</depend>
  <depend>common</depend>
  <depend>semantic_map_manager</depend>
  <depend>vehicle_msgs</depend>
  <depend>protobuf</depend>
  <depend>glog</depend>

  <!-- 当前包不定义 rosidl 接口，但 baseline 仍保留该 build 依赖。 -->
  <build_depend>rosidl_default_runtime</build_depend>

  <!-- 声明标准 ament_cmake 构建类型。 -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
