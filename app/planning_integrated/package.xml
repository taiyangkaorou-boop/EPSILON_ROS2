<?xml version="1.0"?>
<package format="3">
  <!-- 系统集成包：启动语义地图、行为决策和 SSC 轨迹规划，不定义新消息。 -->
  <name>planning_integrated</name>
  <version>0.0.0</version>
  <description>planning_integrated</description>
  <maintainer email="wdingae@todo.com">HKUST_UAV_GROUP</maintainer>
  <license>TODO</license>
  
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- 运行入口直接依赖 ROS2 通信、两个行为规划器、语义地图和 SSC 运动规划器。 -->
  <depend>rclcpp</depend>
  <depend>rclpy</depend>
  <depend>common</depend>
  <depend>semantic_map_manager</depend>
  <depend>behavior_planner</depend>
  <depend>eudm_planner</depend>
  <depend>ssc_planner</depend>
  <depend>protobuf</depend>
  <depend>glog</depend>
  <depend>visualization_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>message_filters</depend>
  <exec_depend>ros2launch</exec_depend>

  <!-- 指定由 ament_cmake 负责配置、安装和导出本包。 -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
